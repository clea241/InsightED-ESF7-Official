# Copy to .env (never commit the real file) and fill in. Values below are placeholders, not real secrets.
# Check the format without printing any value:   npm run check:env            (add -- --strict to require the ones marked REQUIRED)

# --- Server Runtime ---
PORT=5000
NODE_ENV=development                 # production in PM2 (see ecosystem.*.config.cjs)
START_LOCAL_WORKER=false

# --- Authentication (REQUIRED) ---
# Signs and verifies every login token across authentication services.
# Security Requirement: Must be a cryptographically secure random key of at least 32 bytes (256 bits).
# The application enforces runtime startup validation and refuses to start if JWT_SECRET is unset or shorter than 32 characters.
# Generate a valid 32-byte (64 hex characters) secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WARNING: Changing this key logs everyone out (existing tokens stop verifying).
JWT_SECRET=

# --- PostgreSQL Connection Strings (Standardized) ---
# REQUIRED: either DATABASE_URL or the DB_* individual field set below.
# Standard URL format: postgresql://[user]:[password]@[host]:[port]/[dbname]?sslmode=[require|disable]
DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/insighted_esf7
PRIMARY_DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/insighted_esf7

# Named Secondary Databases (optional, falls back to DATABASE_URL if unspecified)
USERS_DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/users_database
INSIGHTED_DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/insighted_esf7
STAGING_DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/insighted_esf7_staging

# --- Redis Queue & Caching (optional; falls back to PostgreSQL queue if absent) ---
# REDIS_URL=redis://127.0.0.1:6379
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379

# --- AI & Tooling ---
# GEMINI_API_KEY=
