# Names only. The real /etc/pm2-watchdog/watchdog.env is mode 600 and is NEVER committed.
WATCHDOG_TELEGRAM_BOT_TOKEN=
WATCHDOG_TELEGRAM_CHAT_ID=
WATCHDOG_SLACK_WEBHOOK_URL=
WATCHDOG_SMTP_HOST=
WATCHDOG_SMTP_PORT=
WATCHDOG_SMTP_USER=
WATCHDOG_SMTP_PASSWORD=
WATCHDOG_SMTP_FROM=
WATCHDOG_SMTP_TO=
# PgBouncer admin console (SHOW POOLS) for the leaked-pool check
PGB_ADMIN_USER=
PGB_ADMIN_PASSWORD=
PGB_HOST=
PGB_PORT=
# Optional read-only Postgres monitor login for the idle-in-transaction alert
WATCHDOG_PG_HOST=
WATCHDOG_PG_PORT=
WATCHDOG_PG_USER=
WATCHDOG_PG_PASSWORD=
WATCHDOG_PG_DB=
PM2_HOME=
