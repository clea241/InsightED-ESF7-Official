[Unit]
Description=PM2 self-heal watchdog (one-shot)
After=network-online.target

[Service]
Type=oneshot
User={{PM2_USER}}
Environment=PM2_HOME={{PM2_HOME}}
EnvironmentFile=/etc/pm2-watchdog/watchdog.env
ExecStart=/usr/bin/python3 /opt/pm2-watchdog/watchdog.py --once
TimeoutStartSec=120
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectControlGroups=true
