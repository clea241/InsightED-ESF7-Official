# Failure-path e2e environment (local, disposable, synthetic data ONLY). Copy to .env.test and adjust.
# Never point these at staging or production. .claude/skills/e2e-failure-path-tests/scripts/guard-test-env.js enforces this.
NODE_ENV=test
# Backend and frontend, local ports only.
APP_URL=http://127.0.0.1:5017
FRONTEND_URL=http://127.0.0.1:4217
PORT=5017
FRONTEND_PORT=4217
# Local database whose name contains "test". If nothing listens on this host:port the runner starts a disposable embedded PostgreSQL there.
# The runner DROPS and recreates this database on every run, so never reuse a database with data you want to keep.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54331/esf7_failurepath_test
# Optional. Must be local if set. Leave empty to test PostgreSQL fallback mode (FP-14 is then skipped and reported).
REDIS_URL=
# Secret used ONLY for this test environment (the app verifies tokens with it and the tests sign tokens with it). Fresh random value, min 32 chars.
JWT_SECRET=
