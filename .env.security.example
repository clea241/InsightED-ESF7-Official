# Security-testing environment. Copy to .env.security (gitignored). Synthetic test accounts ONLY.
LOCAL_APP_URL=http://127.0.0.1:5000
# Local app's database, used only if .env.test is absent. Must be local and its name must contain "test".
LOCAL_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/esf7_security_test
STAGING_APP_URL=
# Comma-separated hostnames that must never be scanned. There is no override.
PRODUCTION_HOSTS=
# Login endpoint and two synthetic accounts in DIFFERENT schools (tenant A and tenant B).
LOGIN_PATH=/api/auth/password-login
TENANT_A_SCHOOL_ID=
TENANT_A_PASSWORD=
TENANT_B_SCHOOL_ID=
TENANT_B_PASSWORD=
