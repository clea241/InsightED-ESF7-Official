# Copy to server/.env (never commit the real file) and fill in. Values below are placeholders, not real secrets.
# Check the format without printing any value:   npm run check:env            (add -- --strict to require the ones marked REQUIRED)

# --- Server ---
PORT=5000
NODE_ENV=development                 # production in PM2 (see ecosystem.*.config.cjs)
START_LOCAL_WORKER=false

# --- Authentication (REQUIRED in production) ---
# Signs and verifies every login token. The server REFUSES TO START with NODE_ENV=production if this is missing or
# shorter than 16 characters. There is no built-in default. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Changing it logs everyone out (existing tokens stop verifying).
JWT_SECRET=

# --- PostgreSQL (REQUIRED: either DATABASE_URL or the DB_* set) ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSL=false
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- Redis queue (optional; without it the queue falls back to PostgreSQL and says so in /api/health) ---
# REDIS_URL=redis://127.0.0.1:6379
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379

# --- Other ---
# GEMINI_API_KEY=
