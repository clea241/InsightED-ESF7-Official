{
  "name": "insighted-esf7-backend",
  "version": "1.0.0",
  "description": "Backend API Server for InsightED ESF7",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:studio": "drizzle-kit studio --config=drizzle.config.js",
    "test:db": "node tests/master_db_verifier.js",
    "db:truncate": "node truncate_esf7_tables.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "express": "^4.19.2",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.3.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.12.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  },
  "nodemonConfig": {
    "ignore": [
      "*.log",
      "scratch/*",
      "temp/*",
      "node_modules/*"
    ]
  }
}
