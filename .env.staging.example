# Staging example for running behind PgBouncer (transaction mode). Copy to the staging server's real env file; never commit
# real values. Values below are placeholders. See docs/ops/pgbouncer.md. Nothing here is applied automatically.

NODE_ENV=production
APP_ENV=staging

# --- Database: the app goes through PgBouncer (6432); scripts and migrations go straight to Postgres (5432) ---
DB_HOST=127.0.0.1
DB_PORT=6432
DB_DIRECT_PORT=5432
DB_NAME=insighted_esf7_staging
DB_USER=
DB_PASSWORD=
DB_SSL=false

# --- Pool sizes per process (defaults in brackets are today's values) ---
PG_POOL_MAX_PRIMARY=8        # [8]
PG_POOL_MAX_INSIGHTED=3      # [5]
PG_POOL_MAX_USERS=3          # [4]
PG_POOL_MAX_STAGING=3        # [5] only used when DB_HOST is not local
PG_POOL_MAX_PROD=3           # [8] only used when DB_HOST is not local
PG_POOL_MAX_WORKER=5         # [8] primary pool of the queue worker process; matches MAX_CONCURRENT_WORKERS
PG_CONNECT_TIMEOUT_MS=10000  # [15000] keep below the nginx timeout and PgBouncer query_wait_timeout

# --- Startup ---
RUN_STARTUP_SCHEMA_INIT=true # [true] false skips the schema checks server.js runs at start (they use DB_DIRECT_PORT)

# --- Queue consumer ---
START_LOCAL_WORKER=false     # web processes never run jobs; the separate worker process does
QUEUE_CONSUMER_ENABLED=true  # [false] the consumer is OFF unless this is true
QUEUE_MAX_ATTEMPTS=5         # [5] then the job stays 'failed' for an alert and manual replay
QUEUE_RETRY_BASE_MS=5000     # [5000] doubles each attempt, jittered 50-100%
QUEUE_RETRY_MAX_MS=300000    # [300000]

# --- Redis (job pointers only; the payload is already committed to Postgres) ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
