# Load-test environment (local, disposable, synthetic data ONLY). Copy to .env.load and adjust.
# Never point these at staging or production. scripts/guard-load-env.js enforces this.
LOAD_BASE_URL=http://127.0.0.1:5007
LOAD_APP_PORT=5007
# Must be a local database whose name contains "test" (for example esf7_load_test). Never a restored backup (drill_*).
LOAD_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/esf7_load_test
# Optional. Must be local if set.
LOAD_REDIS_URL=
# Comma-separated hostnames that must never be targeted.
PRODUCTION_HOSTS=
# Secret used ONLY for this local load environment (app JWT_SECRET and synthetic account tokens). Use a fresh random value, min 32 chars.
LOAD_JWT_SECRET=
# File with synthetic account tokens written by load-test/seed-large.js (gitignored).
LOAD_TEST_ACCOUNTS_FILE=load-test/accounts.json
