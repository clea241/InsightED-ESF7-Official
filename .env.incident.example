# Copy to .env.incident and fill in. Never commit .env.incident. Never put a database password here:
# the read-only database user's password lives in ~/.pgpass on the VM.
# Values marked CONFIRM were taken from ecosystem.esf7-prod.config.cjs; confirm them on the VM (read-only) before relying on them.

# --- SSH (read-only account) ---
PROD_SSH_HOST=
PROD_SSH_USER=
# Optional: only for --target staging dry runs
STAGING_SSH_HOST=
STAGING_SSH_USER=
# Optional: path to the private key on this machine
SSH_KEY=

# --- Where evidence lives on the VM (comma-separated directories) ---
# CONFIRM: app/PM2 logs per ecosystem config; nginx and ~/.pm2/logs paths must be added after checking the VM.
LOG_PATHS=/var/www/html/InsightED-ROSDO/insighted-esf7-prod/logs,/var/log/nginx
PM2_USER=
RELEASE_ROOT=/var/www/html/InsightED-ROSDO/insighted-esf7-prod
# File on the VM holding the current release id (RELEASE_SHA). Leave empty if there is none: the report will say UNKNOWN.
RELEASE_MARKER_FILE=
# Optional: directory holding database backups (read-only listing)
BACKUP_DIR=

# --- Database (read-only role; password stays on the VM in ~/.pgpass) ---
DB_NAME=
DB_READONLY_USER=
DB_HOST=localhost
DB_PORT=5432

# --- Limits ---
QUERY_TIMEOUT_MS=10000
QUERY_ROW_LIMIT=1000
EVIDENCE_MAX_MB=500
